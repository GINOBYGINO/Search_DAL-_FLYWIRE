# Raw / processed / Codex download data (keep directory placeholders)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/download/*
!data/download/.gitkeep

# Intermediate / heavy result artifacts (keep CSV, MD, PNG)
results/*.parquet
results/_probe_*
results/_extension_*.txt
results/_extension_run.txt

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Conda / local caches
*.log
.cache/
